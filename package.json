  "typings": "index.d.ts",
  "author": "Craig Spence <craigspence0@gmail.com>",
  "keywords": [
    "ngx",
    "localStorage",
    "sessionStorage",
    "ruanitto",
    "angular",
    "angular22",
    "localstorage"
  ],
  "scripts": {
    "build": "ng-packagr",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test && npm run build",
    "release": "npm run build && cd dist && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruanitto/ngx-local-storage.git"
  },
  "bugs": {
    "url": "https://github.com/ruanitto/ngx-local-storage/issues",
