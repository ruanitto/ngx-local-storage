    "@angular/core": "^22.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.0.0",
    "ng-packagr": "^22.1.0",
    "rxjs": "~7.8.1",
    "tslib": "~2.6.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "sass": "~1.77.8"
  }
